# Where the SQLite database lives
HOTPULSE_DB=data/hotpulse.db
# Folder with site.yaml, channels/ and prompts/
HOTPULSE_CONFIG=config
# Ollama (free, local AI). Leave as-is if Ollama runs on the same machine.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Optional embedding model for better story grouping (ollama pull nomic-embed-text)
OLLAMA_EMBED_MODEL=
# Set to "off" to force the built-in heuristic mode (no AI)
LLM_MODE=auto
# Password for /admin
ADMIN_TOKEN=change-me
# Public URL used in RSS links and social posts
SITE_URL=http://localhost:8000
